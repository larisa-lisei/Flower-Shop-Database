-- LARISA
CREATE OR REPLACE FUNCTION calculeaza_pret_buchet
(
    p_componente IN pachet_buchete.t_lista_componente,
    p_ambalaj IN buchet.ambalaj%TYPE
)
RETURN NUMBER
AS
    v_pret_floare floare.pret%TYPE;
    v_pret_total buchet.pret%TYPE := 0;
BEGIN
    IF p_componente.COUNT = 0 THEN
        RAISE_APPLICATION_ERROR(
            -20031,
            'Buchetul trebuie sa aiba cel putin o componenta.'
        );
    END IF;

    FOR i in 1 .. p_componente.COUNT LOOP
        SELECT pret
        INTO v_pret_floare
        FROM floare
        WHERE nume = p_componente(i).nume AND
            culoare = p_componente(i).culoare;

        v_pret_total := v_pret_total + v_pret_floare * p_componente(i).cantitate;
    END LOOP;

    IF p_ambalaj = 1 THEN
        v_pret_total := v_pret_total + 30;
    END IF;

    RETURN v_pret_total;
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(
            -20032,
            'Nu exista una sau mai multe flori pentru acest buchet.'
        );
END calculeaza_pret_buchet;
/

-- SIMONA
create or replace function get_pret_produs(
    f_id_furnizor produs.id_furnizor%type,
    f_nume produs.nume%type,
    f_culoare produs.culoare%type)
return produs.pret%type 
as
    v_pret produs.pret%type;
begin

    select pret into v_pret
    from produs
    where id_furnizor = f_id_furnizor and
        lower(nume) = lower(f_nume) and 
        lower(culoare) = lower(f_culoare);
        
    return v_pret;
    
exception
    when NO_DATA_FOUND then 
        return 0;
end;
/

-- LARISA
CREATE OR REPLACE FUNCTION get_stoc_floare
(
    p_nume IN floare.nume%TYPE,
    p_culoare IN floare.culoare%TYPE
)
RETURN NUMBER
AS
    v_stoc floare.stoc%TYPE;
BEGIN
    SELECT stoc
    INTO v_stoc
    FROM floare
    WHERE LOWER(nume)=LOWER(p_nume) AND
        LOWER(Culoare)=LOWER(p_culoare);

    RETURN v_stoc;

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN 0;
END get_stoc_floare;
/

-- SIMONA
create or replace function get_stoc_produs(
    f_id_furnizor produs.id_furnizor%type,
    f_nume produs.nume%type,
    f_culoare produs.culoare%type)
return produs.cantitate%type 
as
    v_stoc produs.cantitate%type;
begin

    select cantitate into v_stoc
    from produs
    where id_furnizor = f_id_furnizor and
        lower(nume) = lower(f_nume) and 
        lower(culoare) = lower(f_culoare);
        
    return v_stoc;
    
exception
    when NO_DATA_FOUND then 
        return 0;
end;
/

CREATE OR REPLACE FUNCTION verifica_stoc_pentru_comanda
(
    p_id_buchet       IN componenta.ID_buchet%TYPE,
    p_numar_buchete   IN comanda.Numar_buchete%TYPE
)
RETURN NUMBER 
AS
    v_stoc_disponibil      floare.stoc%TYPE;
    v_total_flori_necesare NUMBER;
    v_count NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_count FROM componenta
    WHERE id_buchet = p_id_buchet;
    
    IF v_count = 0 THEN
        RAISE_APPLICATION_ERROR(
            -20032,
            'Nu exista buchetul cu id-ul ' || p_id_buchet
        );
    END IF;

    FOR rec IN (
        SELECT nume, culoare, cantitate
        FROM componenta
        WHERE ID_buchet = p_id_buchet
    ) LOOP
        v_stoc_disponibil := get_stoc_floare(rec.Nume, rec.Culoare);
        v_total_flori_necesare := rec.Cantitate * p_numar_buchete;

        IF v_stoc_disponibil < v_total_flori_necesare THEN
            dbms_output.put_line(
                'Stoc insuficient pentru ' || rec.nume ||
                ', culoare: ' || rec.culoare ||
                '. Cantitate necesara: ' || v_total_flori_necesare ||
                CHR(10) || 'Cantitate disponibila: ' || v_stoc_disponibil
            );

            RETURN 0;
        END IF;

    END LOOP;

    DBMS_OUTPUT.PUT_LINE('Stoc suficient pentru comanda.');
    RETURN 1;
END verifica_stoc_pentru_comanda;
/

-- LARISA
CREATE OR REPLACE PROCEDURE creeaza_buchet
(
    p_ambalaj IN buchet.ambalaj%TYPE,
    p_pret_buchet IN buchet.pret%TYPE,
    p_componente IN pachet_buchete.t_lista_componente,

    p_id_buchet OUT buchet.id_buchet%TYPE
)
AS
BEGIN
    INSERT INTO buchet(ambalaj, pret)
    VALUES (p_ambalaj, p_pret_buchet)
    RETURNING ID_buchet INTO p_id_buchet;

    FOR i IN 1 .. p_componente.COUNT LOOP
        INSERT INTO componenta(ID_buchet, nume, culoare, cantitate)
        VALUES(p_id_buchet, p_componente(i).nume, p_componente(i).culoare, p_componente(i).cantitate);
    END LOOP;
END creeaza_buchet;
/

-- SIMONA
create or replace procedure decrementare_stoc_produs(
    p_id_furnizor produs.id_furnizor%type,
    p_nume produs.nume%type,
    p_culoare produs.culoare%type,
    p_cantitate produs.cantitate%type)as
begin

    update produs
    set cantitate = cantitate - p_cantitate
    where id_furnizor = p_id_furnizor and 
        lower(nume) = lower(p_nume) and 
        lower(culoare) = lower(p_culoare);
    
    if SQL%ROWCOUNT = 0 then
        RAISE_APPLICATION_ERROR(-20020, 'Produsul nu exista.');
    end if;
end;
/

