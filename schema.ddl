CREATE OR REPLACE TRIGGER trg_achizitie_data 
    BEFORE INSERT OR UPDATE ON Achizitie 
    FOR EACH ROW 
BEGIN
	IF( :new.data_achizitie > SYSDATE )
	THEN 
		RAISE_APPLICATION_ERROR( -20001,
			'Data invalida: ' || TO_CHAR( :new.data_achizitie, 'DD.MM.YYYY HH24:MI:SS' ) || ' este in viitor.' );
	END IF;
END; 
/

CREATE OR REPLACE TRIGGER trg_actualizare_stoc_dupa_comanda 
    AFTER INSERT ON Comanda 
    FOR EACH ROW 
BEGIN
--LARISA
    FOR rec IN (
        SELECT nume, culoare, cantitate
        FROM componenta c
        WHERE c.ID_buchet = :NEW.ID_buchet
    ) LOOP
        UPDATE floare
        SET stoc = stoc - (rec.cantitate * :NEW.numar_buchete)
        WHERE nume = rec.nume AND
            culoare = rec.culoare;
    END LOOP;
END; 
/

CREATE OR REPLACE TRIGGER trg_anulare_comanda 
    AFTER UPDATE OF Status ON Comanda 
    FOR EACH ROW 
    WHEN ( NEW.status = 'Anulata' and OLD.status != 'Anulata' ) 
declare
    cursor c_componenta is
        select nume, culoare, cantitate
        from componenta
        where id_buchet = :OLD.id_buchet;
begin
-- SIMONA
    if :OLD.status = 'Plasata' then
        for c in c_componenta loop
            update floare
                set stoc = stoc + :OLD.numar_buchete * c.cantitate
                where lower(nume) = lower(c.nume) and 
                    lower(culoare) = lower(c.culoare);
            
            if SQL%ROWCOUNT = 0 then
                ROLLBACK;
                RAISE_APPLICATION_ERROR(-20020, 'Floarea ' || c.nume || 
                    ' ' || c.culoare || ' nu exista.');
            end if;
        end loop;
    end if;
end; 
/

CREATE OR REPLACE TRIGGER trg_comanda_data 
    BEFORE INSERT OR UPDATE ON Comanda 
    FOR EACH ROW 
BEGIN
	IF( :new.data_comenzii <= SYSDATE )
	THEN 
		RAISE_APPLICATION_ERROR( -20001,
			'Data invalida: ' || TO_CHAR( :new.data_comenzii, 'DD.MM.YYYY HH24:MI:SS' ) || ' trebuie sa fie mai mare decat data curenta.' );
	END IF;
END; 
/

CREATE OR REPLACE TRIGGER trg_update_pret_buchet 
    AFTER UPDATE OF Pret ON Floare 
    FOR EACH ROW 
BEGIN
-- LARISA
    FOR rec IN (
        SELECT ID_buchet, cantitate
        FROM componenta
        WHERE nume = :NEW.nume AND
            culoare = :NEW.culoare
    ) LOOP
        UPDATE buchet
        SET pret = pret + ((:NEW.pret - :OLD.pret) * rec.cantitate)
        WHERE ID_buchet = rec.ID_buchet;
    END LOOP;
END; 
/

CREATE OR REPLACE TRIGGER trg_update_stoc_la_achizitie 
    AFTER INSERT ON Produse_Achizitie 
    FOR EACH ROW 
declare
    v_count number;
begin
-- SIMONA
    select count(*) into v_count
    from floare
    where lower(nume) = lower(:NEW.nume) and
        lower(culoare) = lower(:NEW.culoare);
        
    if v_count > 0 then
        update floare
        SET stoc = stoc + :NEW.cantitate
        where lower(nume) = lower(:NEW.nume) and
            lower(culoare) = lower(:NEW.culoare);
    else
        -- daca nu exista in florarie, adaugam
        insert into floare (nume, culoare, pret, stoc) values
            (:NEW.nume, :NEW.culoare, :NEW.pret * 1.5, :NEW.cantitate);
    end if;
    
end; 
/

CREATE SEQUENCE Achizitie_ID_achizitie_SEQ 
START WITH 1 
    NOCACHE 
    ORDER ;

CREATE OR REPLACE TRIGGER Achizitie_ID_achizitie_TRG 
BEFORE INSERT ON Achizitie 
FOR EACH ROW 
WHEN (NEW.ID_achizitie IS NULL) 
BEGIN 
    :NEW.ID_achizitie := Achizitie_ID_achizitie_SEQ.NEXTVAL; 
END;
/

