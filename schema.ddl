-- SIMONA
create or replace procedure efectueaza_achizitie(
    p_id_furnizor produs.id_furnizor%type,
    p_lista_prod pachet_produse.prod_table_type)
as
    v_id_achizitie achizitie.id_achizitie%type;
    v_stoc produs.cantitate%type;
    v_pret produs.pret%type;
    v_pret_total achizitie.pret_total%type := 0;
begin
    insert into achizitie (id_furnizor, data_achizitie, pret_total)
        values (p_id_furnizor, sysdate, 0)
    returning id_achizitie into v_id_achizitie;
        
    for i in 1..p_lista_prod.count() loop
        v_stoc := get_stoc_produs(p_id_furnizor, p_lista_prod(i).nume, p_lista_prod(i).culoare);
        
        if v_stoc < p_lista_prod(i).cantitate then
            ROLLBACK;
            RAISE_APPLICATION_ERROR(-20324,
                'Stoc insuficient pentru produsul ' || p_lista_prod(i).nume);
        end if;
        
        decrementare_stoc_produs(p_id_furnizor, p_lista_prod(i).nume, p_lista_prod(i).culoare,
            p_lista_prod(i).cantitate);
        
        v_pret := get_pret_produs(p_id_furnizor, p_lista_prod(i).nume, p_lista_prod(i).culoare);
        insert into produse_achizitie(id_achizitie, id_furnizor, nume, culoare, cantitate, pret)
            values (v_id_achizitie, p_id_furnizor, p_lista_prod(i).nume, p_lista_prod(i).culoare, 
                p_lista_prod(i).cantitate, v_pret);
                
        v_pret_total := v_pret_total + p_lista_prod(i).cantitate * v_pret;
    end loop;
    
    
    update achizitie
        set pret_total = v_pret_total
    where id_achizitie = v_id_achizitie;
    
    COMMIT;
end;
/

-- LARISA
CREATE OR REPLACE PROCEDURE gaseste_buchet
(
    p_ambalaj IN buchet.ambalaj%TYPE,
    p_pret_buchet IN buchet.pret%TYPE,
    p_componente IN pachet_buchete.t_lista_componente,

    p_id_buchet OUT buchet.id_buchet%TYPE
)
AS
    v_nr_componente_buchet NUMBER;
    v_exista_componenta NUMBER;
    v_identic BOOLEAN;
BEGIN
    IF p_componente.COUNT = 0 THEN
        RAISE_APPLICATION_ERROR(-20030, 'Buchetul trebuie sa aiba cel putin o componenta.');
    END IF;

    p_id_buchet := NULL;

    FOR b IN (
        SELECT ID_buchet
        FROM buchet
        WHERE ambalaj = p_ambalaj
            AND pret = p_pret_buchet
    ) LOOP
        SELECT COUNT(*)
        INTO v_nr_componente_buchet
        FROM componenta
        WHERE ID_buchet = b.ID_buchet;

        IF v_nr_componente_buchet = p_componente.COUNT THEN
            v_identic := TRUE;

            FOR i in 1 .. p_componente.COUNT LOOP
                SELECT COUNT(*)
                INTO v_exista_componenta
                FROM componenta
                WHERE ID_buchet = b.ID_buchet AND
                    nume = p_componente(i).nume AND
                    culoare = p_componente(i).culoare AND
                    cantitate = p_componente(i).cantitate;

                IF v_exista_componenta = 0 THEN
                    v_identic := FALSE;
                    EXIT;
                END IF;
            END LOOP;

            IF v_identic THEN
                p_id_buchet := b.ID_buchet;
                RETURN;
            END IF;
        END IF;
    END LOOP;
END gaseste_buchet;
/

CREATE TABLE Comanda 
    ( 
     ID_comanda    NUMBER (4)  NOT NULL , 
     ID_client     NUMBER (4)  NOT NULL , 
     ID_buchet     NUMBER (4)  NOT NULL , 
     Numar_buchete NUMBER (3)  NOT NULL , 
     Data_comenzii DATE  NOT NULL , 
     Pret          NUMBER (7,2)  NOT NULL , 
     Status        VARCHAR2 (30) 
    ) 
    LOGGING 
;

ALTER TABLE Comanda 
    ADD CONSTRAINT comanda_nr_buchete_ck 
    CHECK (numar_buchete > 0) 
;

ALTER TABLE Comanda 
    ADD CONSTRAINT comanda_pret_ck 
    CHECK (pret>0) 
;

ALTER TABLE Comanda 
    ADD CONSTRAINT comanda_status_ck 
    CHECK (Status IN ('Anulata', 'Finalizata', 'In pregatire', 'Livrata', 'Plasata')) 
;

ALTER TABLE Comanda 
    ADD CONSTRAINT Comanda_PK PRIMARY KEY ( ID_comanda ) ;

-- LARISA
CREATE OR REPLACE PROCEDURE plaseaza_comanda
(
    p_id_client IN client.id_client%TYPE,
    p_ambalaj IN buchet.ambalaj%TYPE,
    p_componente IN pachet_buchete.t_lista_componente,
    p_numar_buchete IN comanda.numar_buchete%TYPE,
    p_data_comenzii IN comanda.data_comenzii%TYPE
)
AS
    v_id_buchet buchet.id_buchet%TYPE;
    v_pret_buchet buchet.pret%TYPE;
BEGIN
    v_pret_buchet := calculeaza_pret_buchet(p_componente, p_ambalaj);

    -- verificare daca deja exista buchetul
    gaseste_buchet(p_ambalaj, v_pret_buchet, p_componente, v_id_buchet);

    -- daca buchetul nu exista deja, se creeaza
    IF v_id_buchet IS NULL THEN
        creeaza_buchet(p_ambalaj, v_pret_buchet, p_componente, v_id_buchet);
        DBMS_OUTPUT.PUT_LINE('S-a creat buchet nou cu ID-ul: ' || v_id_buchet);
    ELSE
        DBMS_OUTPUT.PUT_LINE('S-a gasit buchetul si are ID-ul: ' || v_id_buchet);
    END IF;

    -- verificare stoc
    IF verifica_stoc_pentru_comanda(v_id_buchet, p_numar_buchete) = 0 THEN
        ROLLBACK;

        RAISE_APPLICATION_ERROR(
            -20020,
            'Comanda nu a fost plasata din cauza stocului insuficient.'
        );
    END IF;

    -- stoc suficient, inserez comanda
    INSERT INTO comanda(ID_client, ID_buchet, numar_buchete, data_comenzii, pret, status)
    VALUES(p_id_client, v_id_buchet, p_numar_buchete, p_data_comenzii, v_pret_buchet * p_numar_buchete, 'Plasata');

    COMMIT;

    DBMS_OUTPUT.PUT_LINE('Comanda a fost plasata cu succes.');
END plaseaza_comanda;
/

